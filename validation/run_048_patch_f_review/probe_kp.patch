+static std::atomic<long> gSdxProbePass{0};
+static bool SdxProbeEnabled() {
+  static bool const kOn = std::getenv("SDX_KPROBE") != nullptr;
+  return kOn;
+}
+static bool SdxProbeNow() {
+  if (!SdxProbeEnabled()) return false;
