+// Senua AI patch G, BDF2: the velocity kept for a link at the end of the stage is the BDF2 velocity of its
+// centre, (X(q) - xs) / h_s, that is SuperDex's (X(q) - X(q_s)) / h_s plus the step's D / h_s. Nothing when
+// the stage diverged (SuperDex then resets the link) or when no BDF2 term was formed in the step.
+static void SenuaKeepLinkVelocity(
+    ecs::RequiredTag<TagArticulatedLinkActor>,
+    CConvergenceStatus const& convergence,
+    CTimeIntegratorState const& intState,
+    CActorSnle const& snle,
+    CRigidVel<TimeStep::Current>& currVel,
+    CIntegrationRigidVels& intRigidVels) {
+  if (convergence.stageStatus == ConvergenceStatus::Diverged || !SenuaIsBdf2(intState)) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(gSenuaJacobianMutex);
+  auto const it = gSenuaLinkHistory.find(&snle);
+  if (it == gSenuaLinkHistory.end() || !it->second.dSet) {
+    return;
+  }
+  Real3 const d{it->second.d[0], it->second.d[1], it->second.d[2]};
+  currVel.value.SetVCom(currVel.value.GetVCom() + ToSimd(d));
+  intRigidVels.stages[intState.currentStage].value = currVel.value;
+  it->second.dSet = false;
+}
