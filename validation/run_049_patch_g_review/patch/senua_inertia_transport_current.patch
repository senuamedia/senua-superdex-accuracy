+// Senua AI patch G (off unless SUPERDEX_INERTIA_TRANSPORT is set): the Jacobian of the start of the
+// stage of each articulated body, kept so that the translational inertial force of its links can be
+// projected onto the joints with it (the discrete null space method).
+#include <cstdlib>
