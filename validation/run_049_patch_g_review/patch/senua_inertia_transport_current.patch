+// Senua AI patch G: keep the pose the step starts from, which BDF2's correction is checked against.
+static void SenuaCaptureStepStartPose(
+    ecs::Included<TagArticulatedActor>,
+    CArticulatedReducedPose<TimeStep::Current> const& pose,
+    CActorSnle const& snle) {
+  std::lock_guard<std::mutex> lock(gSenuaJacobianMutex);
+  auto& start = gSenuaStepStartPose[&snle];
+  int const poseSize = static_cast<int>(pose.value.size());
+  start.resize(static_cast<size_t>(poseSize));
+  for (int i = 0; i < poseSize; ++i) {
+    start[static_cast<size_t>(i)] = pose.value(i);
+  }
+}
