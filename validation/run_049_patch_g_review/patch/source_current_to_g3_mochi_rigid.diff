+// Under a multistep integrator: each body's mass and its centre at the start of the stage, for the articulated
+// assembly's BDF2 term (under the same mutex).
+void SenuaInertiaStartStore(void const* key, real mass, Real3 const& start);
+bool SenuaInertiaStartLoad(void const* key, real* mass, real* start);
+static std::unordered_map<void const*, std::array<real, 4>> gSenuaInertiaStart;
+void SenuaInertiaStartStore(void const* key, real mass, Real3 const& start) {
+  std::lock_guard<std::mutex> lock(gSenuaInertiaForceMutex);
+  gSenuaInertiaStart[key] = std::array<real, 4>{mass, start[0], start[1], start[2]};
+}
+bool SenuaInertiaStartLoad(void const* key, real* mass, real* start) {
+  std::lock_guard<std::mutex> lock(gSenuaInertiaForceMutex);
+  auto const it = gSenuaInertiaStart.find(key);
+  if (it == gSenuaInertiaStart.end()) {
+    return false;
+  }
+  *mass = it->second[0];
+  start[0] = it->second[1];
+  start[1] = it->second[2];
+  start[2] = it->second[3];
   return true;
 }
