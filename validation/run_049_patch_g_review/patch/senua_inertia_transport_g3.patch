 using namespace mochi;
 using namespace mochi::dmap;
 
+// Senua AI patch G (off unless SUPERDEX_INERTIA_TRANSPORT is set): the translational inertial force of
+// each rigid body is kept here, so that the articulated assembly can project it onto the joints with the
+// Jacobian of the start of the stage (the discrete null space method).
+#include <array>
+#include <cstdlib>
+#include <mutex>
+#include <unordered_map>
+namespace mochi::rigid {
+bool SenuaInertiaTransportOn();
+void SenuaInertiaTransportStore(void const* key, real fx, real fy, real fz);
+bool SenuaInertiaTransportLoad(void const* key, real* out);
+bool SenuaInertiaTransportOn() {
+  // on when set to anything but empty or 0
+  static bool const kOn = [] {
+    char const* v = std::getenv("SUPERDEX_INERTIA_TRANSPORT");
+    return v != nullptr && v[0] != 0 && !(v[0] == '0' && v[1] == 0);
+  }();
+  return kOn;
+}
+static std::mutex gSenuaInertiaForceMutex;
+static std::unordered_map<void const*, std::array<real, 3>> gSenuaInertiaForce;
+void SenuaInertiaTransportStore(void const* key, real fx, real fy, real fz) {
+  std::lock_guard<std::mutex> lock(gSenuaInertiaForceMutex);
+  gSenuaInertiaForce[key] = std::array<real, 3>{fx, fy, fz};
+}
+bool SenuaInertiaTransportLoad(void const* key, real* out) {
+  std::lock_guard<std::mutex> lock(gSenuaInertiaForceMutex);
+  auto const it = gSenuaInertiaForce.find(key);
+  if (it == gSenuaInertiaForce.end()) {
+    return false;
+  }
+  out[0] = it->second[0];
+  out[1] = it->second[1];
+  out[2] = it->second[2];
+  return true;
+}
+// Under a multistep integrator: each body's mass and its centre at the start of the stage, for the articulated
+// assembly's BDF2 term (under the same mutex).
+void SenuaInertiaStartStore(void const* key, real mass, Real3 const& start);
+bool SenuaInertiaStartLoad(void const* key, real* mass, real* start);
+static std::unordered_map<void const*, std::array<real, 4>> gSenuaInertiaStart;
+void SenuaInertiaStartStore(void const* key, real mass, Real3 const& start) {
+  std::lock_guard<std::mutex> lock(gSenuaInertiaForceMutex);
+  gSenuaInertiaStart[key] = std::array<real, 4>{mass, start[0], start[1], start[2]};
+}
+bool SenuaInertiaStartLoad(void const* key, real* mass, real* start) {
+  std::lock_guard<std::mutex> lock(gSenuaInertiaForceMutex);
+  auto const it = gSenuaInertiaStart.find(key);
+  if (it == gSenuaInertiaStart.end()) {
+    return false;
+  }
+  *mass = it->second[0];
+  start[0] = it->second[1];
+  start[1] = it->second[2];
+  start[2] = it->second[3];
+  return true;
+}
