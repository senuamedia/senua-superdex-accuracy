+// Senua AI patch G (off unless SUPERDEX_INERTIA_TRANSPORT is set), on the links of an articulated body.
+// Backward Euler: the Jacobian of the start of the stage of each articulated body, kept so that the
+// translational inertial force of its links can be projected onto the joints with it (the discrete null
+// space method). BDF2: each link's centre at the start of the last two steps, kept so that the link's
+// centre is treated as BDF2 treats a free body's, as a differential variable (the BDF2 term in
+// EntityAssemble, and the velocity kept for the link at the end of the stage).
+#include <cstdlib>
+#include <mutex>
+#include <unordered_map>
+namespace mochi::rigid {
+bool SenuaInertiaTransportOn();
+bool SenuaInertiaTransportLoad(void const* key, real* out);
