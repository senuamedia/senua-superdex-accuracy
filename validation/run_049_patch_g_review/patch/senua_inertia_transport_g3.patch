+// Senua AI patch G: at the start of each step, keep each link's centre for the BDF2 term (the link's centre is
+// then the one of the end of the step before, or the one it was set to), and clear the step's defect.
+static void SenuaCaptureLinkStepStart(
+    ecs::RequiredTag<TagArticulatedLinkActor>,
+    CRigidState<TimeStep::Current> const& pose,
+    CActorSnle const& snle) {
+  Real3 const centre = pose.value.GetTranslation();
+  std::lock_guard<std::mutex> lock(gSenuaJacobianMutex);
+  auto& history = gSenuaLinkHistory[&snle];
+  for (int k = 0; k < 3; ++k) {
+    history.x[1][k] = history.x[0][k];
+    history.x[0][k] = centre[k];
+    history.d[k] = 0_r;
+  }
+  history.dSet = false;
+  history.starts = history.starts < 2 ? history.starts + 1 : 2;
+}
