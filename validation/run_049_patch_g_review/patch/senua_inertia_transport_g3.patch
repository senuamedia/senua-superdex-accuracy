+} // namespace mochi::rigid
+namespace {
+struct SenuaStageStartJacobian {
+  std::vector<real> pose;
+  std::vector<real> jac; // row major, rows x cols
+  int rows = 0;
+  int cols = 0;
+};
+std::mutex gSenuaJacobianMutex;
+std::unordered_map<void const*, SenuaStageStartJacobian> gSenuaJacobian;
+// A link's history for the BDF2 term (under the same mutex): its centre at the start of each of the last two
+// steps, newest first, and this step's defect D / h_s (see EntityAssemble), which is added to the velocity
+// SuperDex keeps for the link at the end of the stage.
+struct SenuaLinkHistory {
+  real x[2][3] = {};
+  real d[3] = {};
+  bool dSet = false;
+  int starts = 0;
+};
+std::unordered_map<void const*, SenuaLinkHistory> gSenuaLinkHistory;
+// The Jacobian transport is for backward Euler alone, whose stage force is the centred second difference
+// at the start of the step. 0 for every other integrator: BDF2 has its own force term instead, and the
+// rest have not been derived and validated.
+real SenuaTransportShare(CTimeIntegratorState const& s) {
+  if (s.numStages != 1) {
+    return 0_r;
+  }
+  if (s.numSteps == 1 && s.bTilde.Cols() == 1) {
+    if (s.bTilde(0) == 1_r) {
+      return 1_r;
+    }
+    return 0_r;
+  }
+  return 0_r;
+}
+// BDF2 as SuperDex forms it: one stage, two steps, alpha 4/3 and -1/3.
+bool SenuaIsBdf2(CTimeIntegratorState const& s) {
+  return s.numStages == 1 && s.numSteps == 2 && s.alpha.Cols() == 2 &&
+      Abs(s.alpha(0) - 4_r / 3_r) < 1e-12_r && Abs(s.alpha(1) + 1_r / 3_r) < 1e-12_r;
+}
+void SenuaCaptureStageStartJacobian(
+    void const* key,
+    ColumnVector<real> const& pose,
+    RowMatrix<real> const& jac) {
+  std::lock_guard<std::mutex> lock(gSenuaJacobianMutex);
+  auto& entry = gSenuaJacobian[key];
+  entry.rows = static_cast<int>(jac.Rows());
+  entry.cols = static_cast<int>(jac.Cols());
+  int const poseSize = static_cast<int>(pose.size());
+  entry.pose.resize(static_cast<size_t>(poseSize));
+  for (int i = 0; i < poseSize; ++i) {
+    entry.pose[static_cast<size_t>(i)] = pose(i);
+  }
+  entry.jac.resize(static_cast<size_t>(entry.rows) * static_cast<size_t>(entry.cols));
+  for (int r = 0; r < entry.rows; ++r) {
+    for (int c = 0; c < entry.cols; ++c) {
+      entry.jac[static_cast<size_t>(r) * static_cast<size_t>(entry.cols) + static_cast<size_t>(c)] =
+          jac(r, c);
+    }
+  }
+}
