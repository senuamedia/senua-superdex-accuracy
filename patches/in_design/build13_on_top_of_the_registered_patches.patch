+// The pose each step starts from, for the multi-step integrators (under the same mutex).
+std::unordered_map<void const*, std::vector<real>> gSenuaStepStartPose;
+// Where the stage's translational inertial force is radial for a body turning freely about a joint, as a
+// share of the way from the current Jacobian to the one of the start: 1 backward Euler (the start of the
+// stage), 1/3 BDF2 (two thirds of the way from the start of the step to the current pose). 0 for the
+// integrators this has not been derived and validated for.
+real SenuaTransportShare(CTimeIntegratorState const& s) {
+  if (s.numStages != 1) {
+    return 0_r;
+  }
+  if (s.numSteps == 1 && s.bTilde.Cols() == 1) {
+    if (s.bTilde(0) == 1_r) {
+      return 1_r;
+    }
+    return 0_r;
+  }
+  if (s.numSteps == 2 && s.alpha.Cols() == 2 && Abs(s.alpha(0) - 4_r / 3_r) < 1e-12_r &&
+      Abs(s.alpha(1) + 1_r / 3_r) < 1e-12_r) {
+    return 1_r / 3_r;
+  }
+  return 0_r;
+}
