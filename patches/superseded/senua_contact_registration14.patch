+// Anchored Coulomb friction: persistent stick anchors per (colliding, collider, sample), in the
+// collider's local space. Updated by return mapping at each stage start: the anchor follows the
+// contact only when the tangential offset exceeds the stick distance, so friction holds a contact
+// at rest and saturates at mu*N while sliding. Idempotent within a step (uses stage-start data).
+namespace {
+struct FrictionAnchorEntry {
+  Real3 anchor;
+  Real3 lastStageStart;
+};
+std::mutex gFrictionAnchorMutex;
+// The key is the registry, the two actors, the sample on the colliding actor and the feature on the collider
+// (-1 where the collider reports none). A point cloud gives one contact a sample AND a collider point, so
+// without the feature the contacts of one sample would share an anchor.
+std::map<std::tuple<void const*, uint32_t, uint32_t, int, int>, FrictionAnchorEntry> gFrictionAnchors;
+
+void UpdateFrictionAnchors(
+    entt::registry const& reg,
+    entt::entity colliding,
+    entt::entity collider,
+    real stickDistance,
+    ContactDetectionResult& result) {
+  // A sample whose stage-start position jumped further than this since it was last seen has
+  // re-entered contact: it starts a fresh stick.
+  real const kReentryJump = 0.005_r;
+  // With the damped stick on (SUPERDEX_STICK_DAMPING): a contact that carries no normal force at the
+  // stage start holds no stick, so its anchor starts afresh. This is the return mapping onto a
+  // friction limit of zero; without it a body that leaves the surface and lands again is pulled
+  // towards where it stuck before. The stage-start distance is estimated as the kernel estimates it.
+  bool const freshWhenOpen = FrictionStickDamped() &&
+                             result.sdfInfo.val.size() == result.sampleIndices.size() &&
