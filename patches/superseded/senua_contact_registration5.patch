+// Anchored Coulomb friction: persistent stick anchors per (colliding, collider, sample), in the
+// collider's local space. Updated by return mapping at each stage start: the anchor follows the
+// contact only when the tangential offset exceeds the stick distance, so friction holds a contact
+// at rest and saturates at mu*N while sliding. Idempotent within a step (uses stage-start data).
+namespace {
+struct FrictionAnchorEntry {
+  Real3 anchor;
+  Real3 lastStageStart;
+};
+std::mutex gFrictionAnchorMutex;
+std::map<std::tuple<void const*, uint32_t, uint32_t, int>, FrictionAnchorEntry> gFrictionAnchors;
+
+void UpdateFrictionAnchors(
+    entt::registry const& reg,
+    entt::entity colliding,
+    entt::entity collider,
+    real stickDistance,
+    ContactDetectionResult& result) {
+  // A sample whose stage-start position jumped further than this since it was last seen has
+  // re-entered contact: it starts a fresh stick.
+  real const kReentryJump = 0.005_r;
+  result.frictionAnchor.resize_noinit(result.sampleIndices.size());
+  std::lock_guard<std::mutex> lock(gFrictionAnchorMutex);
+  for (int i = 0; i < isize(result.sampleIndices); ++i) {
+    Real3 const p0 = result.posCollidingStageStart[i];
+    Real3 anchor = p0;
+    auto key = std::make_tuple(
+        static_cast<void const*>(&reg),
+        static_cast<uint32_t>(entt::to_integral(colliding)),
+        static_cast<uint32_t>(entt::to_integral(collider)),
+        result.sampleIndices[i]);
+    auto it = gFrictionAnchors.find(key);
+    if (it != gFrictionAnchors.end() && Norm(p0 - it->second.lastStageStart) < kReentryJump) {
+      Real3 n = result.sdfInfo.grad[i];
+      real const nNorm = Norm(n);
+      n = nNorm > 0_r ? n / nNorm : n;
+      Real3 const d = p0 - it->second.anchor;
+      Real3 const dt = d - Dot(d, n) * n;
+      real const dtNorm = Norm(dt);
+      anchor = dtNorm > stickDistance ? p0 - dt * (stickDistance / dtNorm) : p0 - dt;
+    }
+    gFrictionAnchors[key] = {anchor, p0};
+    result.frictionAnchor[i] = anchor;
+  }
+}
+} // namespace
+
+void mochi::ClearFrictionAnchors() {
+  std::lock_guard<std::mutex> lock(gFrictionAnchorMutex);
+  gFrictionAnchors.clear();
+}
